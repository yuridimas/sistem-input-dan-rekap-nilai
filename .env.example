# Contoh konfigurasi lokal untuk API, worker, dan build frontend.
# Salin ke file environment yang sesuai cara menjalankan aplikasi; jangan simpan credential nyata.
# Copy to .env.local and adjust. For non-docker local dev, use localhost hosts.
DB_HOST_PORT=15432
REDIS_HOST_PORT=16379
BACKEND_HOST_PORT=18000
FRONTEND_HOST_PORT=15173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:${DB_HOST_PORT}/grades
REDIS_URL=redis://localhost:${REDIS_HOST_PORT}/0
CORS_ORIGINS=["http://localhost:${FRONTEND_HOST_PORT}","http://127.0.0.1:${FRONTEND_HOST_PORT}","http://localhost:5173","http://localhost:3000"]
JWT_SECRET=change-me-in-production
INSTITUTION_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_TIMEOUT=10
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me
VITE_API_URL=http://localhost:${BACKEND_HOST_PORT}
