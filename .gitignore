# Pengecualian repository untuk cache/dependency dan environment berisi credential.
# Contoh environment tetap terlacak agar setup dapat direproduksi tanpa membagikan rahasia.
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# deployment secrets
.env.local
.env.staging
.env.prod
backend/.env
frontend/.env.local
