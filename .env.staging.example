# Contoh environment profile staging agar pengujian deployment terpisah dari prod.
# Gunakan file/credential staging tersendiri; Compose memasok nilai ke layanan terkait.
# Copy to .env.staging, replace placeholders, and run Compose with --env-file .env.staging.
APP_ENV_FILE=.env.staging
DEPLOYMENT_ENV=staging
POSTGRES_USER=grades
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-secret
POSTGRES_DB=grades
DATABASE_URL=postgresql+asyncpg://grades:replace-with-a-long-url-safe-random-secret@db-deploy:5432/grades
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-unique-admin-password
SUPERADMIN_NAME=Superadmin
INSTITUTION_NAME=
CORS_ORIGINS=["https://staging.example.com"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_TIMEOUT=10
DB_HOST_PORT=25432
REDIS_HOST_PORT=26379
HTTP_PORT=28080
UVICORN_WORKERS=2
