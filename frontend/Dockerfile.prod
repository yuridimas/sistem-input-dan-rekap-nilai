# Build frontend di Node lalu salin hanya aset hasil build ke image Nginx.
# VITE_API_URL dimasukkan saat build, bukan dibaca ulang oleh browser dari environment container.
FROM node:24-alpine3.24 AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Path relatif /api membuat browser memakai origin proxy yang sama dengan frontend.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM nginx:1.31-alpine3.24-slim

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --retries=5 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
