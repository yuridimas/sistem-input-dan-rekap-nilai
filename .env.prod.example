# Contoh environment profile prod pada Compose untuk API, worker, database, dan proxy.
# APP_ENV_FILE memilih file layanan; nilai credential contoh harus diganti di file lokal deployment.
# Copy to .env.prod, replace placeholders, and run Compose with --env-file .env.prod.
APP_ENV_FILE=.env.prod
DEPLOYMENT_ENV=prod
POSTGRES_USER=grades
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-secret
POSTGRES_DB=grades
DATABASE_URL=postgresql+asyncpg://grades:replace-with-a-long-url-safe-random-secret@db-deploy:5432/grades
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-unique-admin-password
SUPERADMIN_NAME=Superadmin
INSTITUTION_NAME=
CORS_ORIGINS=["https://grades.example.com"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_TIMEOUT=10
DB_HOST_PORT=35432
REDIS_HOST_PORT=36379
HTTP_PORT=38080
UVICORN_WORKERS=2
